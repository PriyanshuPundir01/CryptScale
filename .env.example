# CryptScale Environment Configuration

# Flask Core Settings
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-cryptographically-secure-random-32-byte-secret

# Server Network Settings
HOST=127.0.0.1
PORT=5001

# Cross-Origin Resource Sharing (CORS) - Comma separated origins
ALLOWED_ORIGINS=http://127.0.0.1:5001,http://localhost:5001

# Rate Limiting Storage (e.g. memory:// or redis://localhost:6379)
RATELIMIT_STORAGE_URI=memory://

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
# Alternatively, specify a pre-hashed PBKDF2/scrypt password:
# ADMIN_PASSWORD_HASH=

# Session Security (Set to 1 when serving over HTTPS)
SESSION_COOKIE_SECURE=0

# Optional API Keys
HIBP_API_KEY=

